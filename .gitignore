# Rust / Cargo
target/
# ...but the LLVM backend target *sources* live in llvm-<chip>/target/ and ARE tracked.
!llvm-*/target/
!llvm-*/target/**
debug/
**/*.rs.bk
*.pdb
**/mutants.out*/
rustc-ice-*.txt

# Per-title and per-backend generated output
system/*/*/build/
system/*/platform/sim/build/
llvm-*/build/
llvm-*/install/
llvm-*/build_llvm.out
llvm-*/tests/.lit/
**/Output/

# Top-level scratch/build area (diagnostic scripts, relink output, traces).
/build/

# Original software images: provenance + SHA-256 are committed, the binaries are not.
# A freely redistributable image may be force-added and noted in provenance.md.
system/*/*/original/*
!system/*/*/original/provenance.md
!system/*/*/original/*.sha256
!system/*/*/original/fetch.sh

# Large or bulky simulator output
*.vcd
*.fst
*.fst.hier
*.xtrace
*.log

# Caches
.firecrawl/
__pycache__/
*.pyc
.venv/

# OS / editor
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/

# Local agent state
.kiro/
.mimosa/

# Git worktrees (see AGENTS.md: all worktrees live under worktrees/)
/worktrees/

# Browser-machine WASM artifact (built by web/*/scripts/build.sh from source)
system/*/*/web/www/*.wasm
.mimosa/
web/wasm/.mimosa/
