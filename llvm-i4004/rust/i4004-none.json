{
  "_comment": "Draft Rust target for i4004. data-layout MUST equal llvm-i4004/spec/abi.md section 1 exactly (CI greps both). Requires nightly and -Zbuild-std=core. See spec/abi.md for the rationale behind every field.",
  "arch": "i4004",
  "llvm-target": "i4004-unknown-none",
  "data-layout": "e-m:e-p:16:8-p1:16:8-p2:16:8-i8:8-i16:8-n8-a:8",
  "target-pointer-width": "16",
  "target-c-int-width": "16",
  "target-endian": "little",
  "os": "none",
  "env": "",
  "vendor": "unknown",
  "executables": true,
  "panic-strategy": "abort",
  "relocation-model": "static",
  "linker-flavor": "gnu-lld",
  "linker": "rust-lld",
  "disable-redzone": true,
  "max-atomic-width": 0,
  "atomic-cas": false,
  "singlethread": true
}
