# Target settings for ibm_pc_xt_5160; sourced by scripts. One chip/backend per platform.
CHIP=i8086
# Image kinds, in bring-up order (spec/cpu_abi.md sec.8). The packer selects one.
IMAGE_KINDS="boot com"
# Oracle builds (plans/testplan.md). MartyPC submodule not initialized yet.
MARTYPC_DIR=external/martypc
XT_RTL_DIR=${AI_HW_ENGINEER:-../ai_hw_engineer}/system/ibm_pc_xt_5160
