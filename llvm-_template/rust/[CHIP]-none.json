{
  "_comment": "Draft Rust target for [CHIP]. data-layout must equal spec/abi.md exactly. Requires nightly and -Zbuild-std=core.",
  "arch": "[CHIP]",
  "llvm-target": "[CHIP]-unknown-none",
  "data-layout": "TODO",
  "target-pointer-width": "16",
  "target-c-int-width": "16",
  "target-endian": "little",
  "os": "none",
  "executables": true,
  "panic-strategy": "abort",
  "relocation-model": "static",
  "linker-flavor": "gnu-lld",
  "linker": "rust-lld",
  "disable-redzone": true,
  "max-atomic-width": 0,
  "atomic-cas": false,
  "singlethread": true
}
